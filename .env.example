# Fastest: Google Sheets API with a service account (see docs/luu-du-lieu-google-sheet.md).
# Share the Google Sheet with this email as Editor. Keep the key on one line with \n.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Fallback when no service account is set: deploy google-apps-script/Code.gs
# as a Web app and copy its /exec URL here.
GOOGLE_APPS_SCRIPT_URL=
GOOGLE_SHEETS_SYNC_SECRET=
GOOGLE_SHEET_ID=1zBAWSnDb0h1oLsTkJzgclUXHtUrcG8FSIQ32NJ1jiDI

# Optional. When set, the app shows a login screen and stores only a password hash/salt in App_Users.
AUTH_SECRET=

# Optional: account used for manual testing (see docs/test-tai-khoan-vietanh.md). Keep real values in .env.local only.
TEST_ACCOUNT_USERNAME=
TEST_ACCOUNT_PASSWORD=
